<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP to a local test server and nowhere else.
     10.0.2.2 is the AVD emulator's alias for the host machine's loopback; 127.0.0.1
     is the same host reached through `adb reverse tcp:<port> tcp:<port>`, which is
     how a container-based Android image or a real phone on a cable gets there.
     Everything else keeps the platform default: cleartext refused, system CAs only.
     Used by debug builds and by the release self-test build (see build.gradle.kts);
     a normal release build never references this file. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
